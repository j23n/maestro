.DS_Store
.build/
.swiftpm/
DerivedData/
xcuserdata/
*.xcuserstate

# The Xcode project is generated from project.yml (make project).
Maestro.xcodeproj/
# Your signing team (make signing TEAM=…), on this Mac only
Signing.xcconfig

# Python
__pycache__/
.pytest_cache/
.venv/

# The content database (tools/), built by the pipeline, not committed
content/build/
# What `make content` writes into the app bundle
App/Resources/Content/*
!App/Resources/Content/README.md

# A draft from make draft that did not build (tools/maestro_content/draft.py, set_aside)
content/texts/**/*.md.failed
