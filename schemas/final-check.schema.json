{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://italiano.invalid/schemas/final-check.schema.json",
  "title": "Final A1 check (content/assessments/final-check.yaml)",
  "description": "docs/05 § Final A1 check, docs/06 § 20. Five sections of 12 points; exercise IDs are fin.<section>.NN.",
  "type": "object",
  "required": ["id", "review", "sections"],
  "properties": {
    "id": {"const": "final"},
    "review": {"$ref": "common.schema.json#/$defs/review"},
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title_en", "max", "exercises"],
        "properties": {
          "id": {"enum": ["listening", "reading", "structures", "writing", "speaking"], "title": "final-check section"},
          "title_en": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
          "max": {"type": "integer", "minimum": 1},
          "tags": {"$ref": "common.schema.json#/$defs/tags"},
          "exercises": {"type": "array", "items": {"$ref": "exercise.schema.json"}}
        },
        "additionalProperties": false
      }
    },
    "indicative_pass_per_section": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}
