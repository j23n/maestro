{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://italiano.invalid/schemas/check.schema.json",
  "title": "Unit check (content/units/NN-slug/check.yaml)",
  "description": "docs/06 § 18. Check mode: one attempt per item; each item has a `score` (default 1).",
  "type": "object",
  "required": ["id", "review", "pass", "sections"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^u\\d{2}\\.check$",
      "x-message": "'{value}' is not a unit check ID (uNN.check)"
    },
    "review": {"$ref": "common.schema.json#/$defs/review"},
    "pass": {
      "type": "object",
      "required": ["overall", "section_min"],
      "properties": {
        "overall": {"type": "number", "minimum": 0, "maximum": 1},
        "section_min": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title_en", "exercises"],
        "properties": {
          "id": {"enum": ["listening", "reading", "writing", "speaking"], "title": "check section"},
          "title_en": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
          "exercises": {"type": "array", "minItems": 1, "items": {"$ref": "exercise.schema.json"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
