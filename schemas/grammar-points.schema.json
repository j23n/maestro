{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://italiano.invalid/schemas/grammar-points.schema.json",
  "title": "Course grammar points (content/grammar/points.yaml)",
  "description": "docs/03 § Grammar points: the pedagogical decisions the content lead approves.",
  "type": "object",
  "required": ["review", "points"],
  "properties": {
    "review": {"$ref": "common.schema.json#/$defs/review"},
    "points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "unit", "status", "syllabus"],
        "properties": {
          "id": {"type": "string", "format": "id:grammar"},
          "title": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
          "unit": {"type": "string", "format": "id:unit"},
          "status": {"enum": ["P", "R", "chunk"], "title": "grammar status"},
          "syllabus": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "id:syllabus"}},
          "requires": {"type": "array", "items": {"type": "string", "format": "id:grammar"}},
          "confusable": {"type": "array", "items": {"type": "string", "format": "id:grammar"}},
          "graded": {"enum": ["developing"], "title": "grading mode"},
          "about": {"type": "string"},
          "decide": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
