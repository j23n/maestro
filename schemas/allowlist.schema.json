{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://italiano.invalid/schemas/allowlist.schema.json",
  "title": "Tokens allowed untaught (content/allowlist.yaml)",
  "description": "docs/04 § Annotation: names (case-sensitive), interjections and transparent words.",
  "type": "object",
  "properties": {
    "names": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/nonEmptyString"}},
    "interjections": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/nonEmptyString"}},
    "transparent": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["form", "gloss"],
        "properties": {
          "form": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
          "gloss": {"$ref": "common.schema.json#/$defs/nonEmptyString"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
