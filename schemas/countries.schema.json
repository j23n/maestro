{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://italiano.invalid/schemas/countries.schema.json",
  "title": "Countries for onboarding (content/countries.yaml)",
  "description": "docs/03 § The answer-pattern language (personal slots {ME.home}, {ME.nationality}, {ME.country}).",
  "type": "object",
  "required": ["review", "countries", "other"],
  "properties": {
    "review": {"$ref": "common.schema.json#/$defs/review"},
    "countries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "en", "it", "home_phrase", "m", "f"],
        "properties": {
          "id": {"type": "string", "format": "id:country"},
          "en": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
          "it": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
          "home_phrase": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
          "alt_home_phrases": {"$ref": "common.schema.json#/$defs/nonEmptyStrings"},
          "m": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
          "f": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
          "note": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "other": {
      "type": "object",
      "required": ["en"],
      "properties": {"en": {"$ref": "common.schema.json#/$defs/nonEmptyString"}, "note": {"type": "string"}},
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
