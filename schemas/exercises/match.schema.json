{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://italiano.invalid/schemas/exercises/match.schema.json",
  "title": "match exercise",
  "description": "docs/06 § Building-block formats. 2–6 pairs; targets[i] belongs to pairs[i] (lint checks the counts).",
  "type": "object",
  "required": ["id", "format", "targets", "tags", "pairs"],
  "properties": {
    "id": {"$ref": "../common.schema.json#/$defs/exerciseId"},
    "format": {"const": "match"},
    "targets": {"$ref": "../common.schema.json#/$defs/targets"},
    "tags": {"$ref": "../common.schema.json#/$defs/tags"},
    "source": {"$ref": "../common.schema.json#/$defs/source"},
    "pairs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "minLength": 1}}
    },
    "hint": {"type": "string"},
    "score": {"$ref": "../common.schema.json#/$defs/score"}
  },
  "additionalProperties": false
}
