{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://italiano.invalid/schemas/exercises/cloze.schema.json",
  "title": "cloze exercise",
  "description": "docs/06 § 6. One gap [[…]] per exercise; the gap is entirely focus.",
  "type": "object",
  "required": ["id", "format", "targets", "tags", "text", "prompt_en"],
  "properties": {
    "id": {"$ref": "../common.schema.json#/$defs/exerciseId"},
    "format": {"const": "cloze"},
    "targets": {"$ref": "../common.schema.json#/$defs/targets"},
    "tags": {"$ref": "../common.schema.json#/$defs/tags"},
    "lemmas": {"$ref": "../common.schema.json#/$defs/lemmas"},
    "source": {"$ref": "../common.schema.json#/$defs/source"},
    "text": {
      "type": "string",
      "pattern": "^(?:(?!\\[\\[)[\\s\\S])*\\[\\[(?:(?!\\]\\])[\\s\\S])+\\]\\](?:(?!\\[\\[)[\\s\\S])*$",
      "x-message": "a cloze text needs exactly one gap [[…]]: '{value}'"
    },
    "prompt_en": {"$ref": "../common.schema.json#/$defs/nonEmptyString"},
    "bank": {"type": ["array", "null"], "items": {"type": "string", "minLength": 1}},
    "hint": {"type": "string"},
    "rule": {"type": "string"},
    "near": {"$ref": "../common.schema.json#/$defs/near"},
    "audio_after": {"type": "boolean"},
    "score": {"$ref": "../common.schema.json#/$defs/score"}
  },
  "additionalProperties": false
}
