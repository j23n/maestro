{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://italiano.invalid/schemas/exercises/sentence-building.schema.json",
  "title": "sentence-building exercise",
  "description": "docs/06 § 8. Every accepted order uses exactly the tiles (distractors excluded); lint checks it.",
  "type": "object",
  "required": ["id", "format", "targets", "tags", "prompt_en", "tiles", "answer"],
  "properties": {
    "id": {"$ref": "../common.schema.json#/$defs/exerciseId"},
    "format": {"const": "sentence-building"},
    "targets": {"$ref": "../common.schema.json#/$defs/targets"},
    "tags": {"$ref": "../common.schema.json#/$defs/tags"},
    "lemmas": {"$ref": "../common.schema.json#/$defs/lemmas"},
    "source": {"$ref": "../common.schema.json#/$defs/source"},
    "prompt_en": {"$ref": "../common.schema.json#/$defs/nonEmptyString"},
    "tiles": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
    "distractors": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "answer": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "hint": {"type": "string"},
    "rule": {"type": "string"},
    "near": {"$ref": "../common.schema.json#/$defs/near"},
    "audio_after": {"type": "boolean"},
    "score": {"$ref": "../common.schema.json#/$defs/score"}
  },
  "additionalProperties": false
}
