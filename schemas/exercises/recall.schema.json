{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://italiano.invalid/schemas/exercises/recall.schema.json",
  "title": "recall exercise (English → Italian)",
  "description": "docs/06 § 7.",
  "type": "object",
  "required": ["id", "format", "targets", "tags", "prompt_en", "answer"],
  "properties": {
    "id": {"$ref": "../common.schema.json#/$defs/exerciseId"},
    "format": {"const": "recall"},
    "targets": {"$ref": "../common.schema.json#/$defs/targets"},
    "tags": {"$ref": "../common.schema.json#/$defs/tags"},
    "source": {"$ref": "../common.schema.json#/$defs/source"},
    "prompt_en": {"$ref": "../common.schema.json#/$defs/nonEmptyString"},
    "context_it": {"type": ["string", "null"]},
    "answer": {"$ref": "../common.schema.json#/$defs/pattern"},
    "hint": {"type": "string"},
    "rule": {"type": "string"},
    "near": {"$ref": "../common.schema.json#/$defs/near"},
    "audio_after": {"type": "boolean"},
    "score": {"$ref": "../common.schema.json#/$defs/score"}
