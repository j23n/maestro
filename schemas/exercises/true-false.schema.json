{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://italiano.invalid/schemas/exercises/true-false.schema.json",
  "title": "true-false exercise",
  "description": "docs/06 § Building-block formats.",
  "type": "object",
  "required": ["id", "format", "tags", "statement_en", "answer"],
  "properties": {
    "id": {"$ref": "../common.schema.json#/$defs/exerciseId"},
    "format": {"const": "true-false"},
    "targets": {"$ref": "../common.schema.json#/$defs/targets"},
    "tags": {"$ref": "../common.schema.json#/$defs/tags"},
    "lemmas": {"$ref": "../common.schema.json#/$defs/lemmas"},
    "source": {"$ref": "../common.schema.json#/$defs/source"},
    "prompt_it": {"type": ["string", "null"]},
    "audio": {"$ref": "../common.schema.json#/$defs/audio"},
    "audio_text": {"$ref": "../common.schema.json#/$defs/audioText"},
    "plays": {"$ref": "../common.schema.json#/$defs/plays"},
    "statement_en": {"$ref": "../common.schema.json#/$defs/nonEmptyString"},
    "answer": {"type": "boolean"},
    "hint": {"type": "string"},
    "rule": {"type": "string"},
    "score": {"$ref": "../common.schema.json#/$defs/score"}
  },
  "additionalProperties": false
}
