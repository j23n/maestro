{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://italiano.invalid/schemas/exercises/relay.schema.json",
  "title": "relay exercise (mediation)",
  "description": "docs/06 § 15. The learner answers a friend in English from an Italian source. No targets (no FSRS).",
  "type": "object",
  "required": ["id", "format", "tags", "source", "friend_en", "answer_en"],
  "properties": {
    "id": {"$ref": "../common.schema.json#/$defs/exerciseId"},
    "format": {"const": "relay"},
    "tags": {"$ref": "../common.schema.json#/$defs/tags"},
    "source": {
      "allOf": [{"$ref": "../common.schema.json#/$defs/source"}],
      "type": ["string", "object"]
    },
    "friend_en": {"$ref": "../common.schema.json#/$defs/nonEmptyString"},
    "answer_en": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"enum": ["time", "price", "number", "text"], "title": "relay answer type"},
        "value": {"type": ["number", "string"]},
        "accept": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false,
      "allOf": [
        {"if": {"properties": {"type": {"const": "text"}}, "required": ["type"]}, "then": {"required": ["accept"]}},
        {"if": {"properties": {"type": {"enum": ["price", "number"]}}, "required": ["type"]}, "then": {"required": ["value"], "properties": {"value": {"type": "number"}}}},
        {"if": {"properties": {"type": {"const": "time"}}, "required": ["type"]}, "then": {"required": ["value"], "properties": {"value": {"type": "string", "pattern": "^\\d{1,2}:\\d{2}$", "x-message": "a time answer is written like 15:30, not '{value}'"}}}}
      ]
    },
    "score": {"$ref": "../common.schema.json#/$defs/score"}
  },
  "additionalProperties": false
}
