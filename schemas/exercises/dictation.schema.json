    "source": {"$ref": "../common.schema.json#/$defs/source"},
    "say": {"$ref": "../common.schema.json#/$defs/nonEmptyString"},
    "slow": {"type": "boolean"},
    "plays": {"$ref": "../common.schema.json#/$defs/plays"},
    "hint": {"type": "string"},
    "rule": {"type": "string"},
    "near": {"$ref": "../common.schema.json#/$defs/near"},
