{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://italiano.invalid/schemas/exercises/dictation.schema.json",
  "title": "dictation exercise",
  "description": "docs/06 § 9.",
  "type": "object",
  "required": ["id", "format", "targets", "tags", "say"],
  "properties": {
    "id": {"$ref": "../common.schema.json#/$defs/exerciseId"},
