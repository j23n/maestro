{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://italiano.invalid/schemas/exercises/writing.schema.json",
  "title": "guided writing exercise",
  "description": "docs/06 § 14. Forms have `fields`; free texts have `words`, `points`, `pass` and a `model`. No targets (no FSRS).",
  "type": "object",
  "required": ["id", "format", "kind", "tags", "prompt_en"],
  "properties": {
    "id": {"$ref": "../common.schema.json#/$defs/exerciseId"},
    "format": {"const": "writing"},
    "kind": {"enum": ["form", "message", "postcard", "list", "description"], "title": "writing kind"},
    "tags": {"$ref": "../common.schema.json#/$defs/tags"},
    "source": {"$ref": "../common.schema.json#/$defs/source"},
    "prompt_en": {"$ref": "../common.schema.json#/$defs/nonEmptyString"},
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["label_it", "label_en", "type"],
        "properties": {
          "label_it": {"$ref": "../common.schema.json#/$defs/nonEmptyString"},
          "label_en": {"$ref": "../common.schema.json#/$defs/nonEmptyString"},
          "type": {"enum": ["text", "email", "number", "date", "phone"], "title": "form field type"},
          "accept": {"$ref": "../common.schema.json#/$defs/patterns"}
        },
        "additionalProperties": false
      }
    },
    "words": {"$ref": "../common.schema.json#/$defs/minMax"},
    "points": {"$ref": "../common.schema.json#/$defs/points"},
    "pass": {"type": "integer", "minimum": 1},
    "model": {"type": ["string", "null"]},
    "score": {"$ref": "../common.schema.json#/$defs/score"}
  },
  "additionalProperties": false,
  "if": {"properties": {"kind": {"const": "form"}}, "required": ["kind"]},
  "then": {"required": ["fields"]},
  "else": {"required": ["words", "points", "pass", "model"]}
}
