{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://italiano.invalid/schemas/story-bible.schema.json",
  "title": "Story bible (content/story-bible.yaml)",
  "description": "docs/03 § Story bible, docs/04 § Check 5. The checker reads characters and registers; the content-critic reads all of it.",
  "type": "object",
  "required": ["review", "characters", "registers"],
  "properties": {
    "review": {"$ref": "common.schema.json#/$defs/review"},
    "setting": {"type": "object", "additionalProperties": {"type": "string"}},
    "characters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": {"type": "string", "format": "id:character"},
          "name": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
          "first_unit": {"type": "string", "format": "id:unit"}
        },
        "additionalProperties": {"type": ["string", "number", "boolean"]}
      }
    },
    "places": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "kind"],
        "properties": {
          "name": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
          "kind": {"enum": ["real", "fictional"], "title": "place kind"},
          "note": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["units", "when"],
        "properties": {
          "units": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "id:unit"}},
          "when": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
          "arc": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "facts_to_check": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["unit", "fact"],
        "properties": {
          "unit": {"type": "string", "format": "id:unit"},
          "fact": {"$ref": "common.schema.json#/$defs/nonEmptyString"}
        },
        "additionalProperties": false
      }
    },
    "registers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["from", "to", "register", "units"],
        "properties": {
          "from": {"$ref": "#/$defs/party"},
          "to": {"$ref": "#/$defs/party"},
          "register": {"$ref": "common.schema.json#/$defs/register"},
          "then": {"$ref": "common.schema.json#/$defs/register"},
          "switch_at": {"type": "string", "format": "id:step"},
          "units": {
            "type": ["string", "array"],
            "if": {"type": "string"},
            "then": {"const": "all", "x-message": "units is [from, to] or the word all"},
            "else": {"minItems": 2, "maxItems": 2, "items": {"type": "string", "format": "id:unit"}, "x-message": "units is [from, to] or the word all"}
          },
          "note": {"type": "string"}
        },
        "dependentRequired": {"then": ["switch_at"], "switch_at": ["then"]},
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "party": {
      "type": "string",
      "if": {"const": "*"},
      "then": true,
      "else": {"format": "id:character"}
    }
  }
}
