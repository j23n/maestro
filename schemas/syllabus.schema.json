{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://italiano.invalid/schemas/syllabus.schema.json",
  "title": "A1 syllabus inventory (content/syllabus/a1-syllabus.yaml)",
  "description": "docs/03 § Syllabus, docs/04 § Check 1. `covered_by` refs: g: s: cd: topic: kind: format: section:.",
  "type": "object",
  "required": ["version", "review", "sources", "items"],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "review": {"$ref": "common.schema.json#/$defs/review"},
    "sources": {"$ref": "common.schema.json#/$defs/stringMap"},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "area", "label", "units", "covered_by"],
        "properties": {
          "id": {"type": "string", "format": "id:syllabus"},
          "area": {"enum": ["gr", "fn", "tp", "ss", "cefr", "ex"], "title": "syllabus area"},
          "label": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
          "sources": {"$ref": "common.schema.json#/$defs/stringMap"},
          "course": {"type": "string"},
          "units": {
            "type": ["string", "array"],
            "if": {"type": "string"},
            "then": {"const": "all", "x-message": "units is a list of units or the word all"},
            "else": {"items": {"type": "string", "format": "id:unit"}}
          },
          "roles": {
            "type": "array",
            "uniqueItems": true,
            "items": {"enum": ["introduced", "practised", "assessed"], "title": "coverage role"}
          },
          "covered_by": {"type": "array", "items": {"type": "string", "format": "id:coverage_ref"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
