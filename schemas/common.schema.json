{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://italiano.invalid/schemas/common.schema.json",
  "title": "Shared definitions",
  "description": "Definitions shared by the content schemas (docs/03, docs/06). ID formats use the custom format `id:<kind>` (or `id:<kind>|<kind>`; `id:*` for any course ID), checked against pipeline/src/itcontent/ids.py, the single source of ID patterns. Two lint-only annotations: `x-message` is the message `content lint` prints when that subschema fails (`{value}` is the offending value), and `x-keys` describes the allowed keys of an object with pattern keys.",
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "strings": {"type": "array", "items": {"type": "string"}},
    "nonEmptyStrings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "stringMap": {"type": "object", "additionalProperties": {"type": "string"}},
    "localId": {"type": "string", "format": "id:conversation_node"},
    "range": {
      "type": "string",
      "pattern": "^\\d+-\\d+$",
      "x-message": "'{value}' is not a range like 55-70"
    },
    "minMax": {
      "type": "object",
      "required": ["min", "max"],
      "properties": {"min": {"type": "integer", "minimum": 0}, "max": {"type": "integer", "minimum": 1}},
      "additionalProperties": false
    },
    "semver": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "x-message": "'{value}' is not a version like 0.1.0"
    },
    "review": {
      "description": "docs/03 § Review status and approval. Only `content approve` / `content reopen` change it.",
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["draft", "in-review", "approved"], "title": "review status"},
        "by": {"type": ["string", "null"]},
        "date": {"type": ["string", "null"], "format": "date"},
        "hash": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$",
          "x-message": "'{value}' is not a sha256 hex digest (docs/04 § Approval hash)"
        }
      },
      "additionalProperties": false,
      "if": {"properties": {"status": {"const": "approved"}}, "required": ["status"]},
      "then": {
        "required": ["by", "date", "hash"],
        "x-message": "an approved file needs review.{missing} (set by content approve)",
        "properties": {
          "by": {"type": "string", "minLength": 1, "x-message": "an approved file needs review.by (set by content approve)"},
          "date": {"type": "string", "x-message": "an approved file needs review.date (set by content approve)"},
          "hash": {"type": "string", "x-message": "an approved file needs review.hash (set by content approve)"}
        }
      },
      "else": {
        "properties": {
          "by": {"type": "null", "x-message": "only approved files carry review.by; content reopen clears it"},
          "date": {"type": "null", "x-message": "only approved files carry review.date; content reopen clears it"},
          "hash": {"type": "null", "x-message": "only approved files carry review.hash; content reopen clears it"}
        }
      }
    },
    "titleItEn": {
      "type": "object",
      "required": ["it", "en"],
      "properties": {"it": {"$ref": "#/$defs/nonEmptyString"}, "en": {"$ref": "#/$defs/nonEmptyString"}},
      "additionalProperties": false
    },
    "titleEn": {
      "type": "object",
      "required": ["en"],
      "properties": {"it": {"$ref": "#/$defs/nonEmptyString"}, "en": {"$ref": "#/$defs/nonEmptyString"}},
      "additionalProperties": false
    },
    "titleAny": {
      "type": "object",
      "minProperties": 1,
      "properties": {"it": {"$ref": "#/$defs/nonEmptyString"}, "en": {"$ref": "#/$defs/nonEmptyString"}},
      "additionalProperties": false
    },
    "register": {"enum": ["tu", "lei"], "title": "register"},
    "skill": {"enum": ["read", "listen", "recall", "speak"], "title": "skill"},
    "itemStatus": {"enum": ["P", "R"], "title": "item status"},
    "exerciseId": {"type": "string", "format": "id:exercise"},
    "target": {
      "description": "A primary target: what the exercise trains (docs/03 § Exercises).",
      "type": "object",
      "required": ["item", "skill"],
      "properties": {
        "item": {"type": "string", "format": "id:item"},
        "skill": {"$ref": "#/$defs/skill"}
      },
      "additionalProperties": false
    },
    "targets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/target"}},
    "tags": {
      "description": "Alignment: at least one can-do or syllabus ID (docs/04 § Check 4).",
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "format": "id:can_do|syllabus"}
    },
    "pattern": {"type": "string", "minLength": 1, "description": "An answer pattern (docs/03 § The answer-pattern language)."},
    "patterns": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/pattern"}},
    "near": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["answer", "hint"],
        "properties": {
          "answer": {"$ref": "#/$defs/pattern"},
          "hint": {"$ref": "#/$defs/nonEmptyString"},
          "outcome": {"enum": ["almost", "wrong", "correctWithNote"], "title": "near-miss outcome"}
        },
        "additionalProperties": false
      }
    },
    "score": {"type": "number", "exclusiveMinimum": 0},
    "plays": {"type": ["integer", "null"], "minimum": 1},
    "audio": {
      "type": "object",
      "required": ["speaker"],
      "properties": {"speaker": {"type": "string", "format": "id:speaker"}},
      "additionalProperties": false
    },
    "points": {
      "description": "Content points of talk and writing (docs/06 § 13, § 14).",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "en", "accept"],
        "properties": {
          "id": {"$ref": "#/$defs/localId"},
          "en": {"$ref": "#/$defs/nonEmptyString"},
          "accept": {"$ref": "#/$defs/patterns"}
        },
        "additionalProperties": false
      }
    },
    "lemmas": {
      "description": "Disambiguation overrides {Italian form: item ID} (docs/03 § Texts, § Exercises): on a text line for that line, on an exercise for all its own Italian strings, on a real-world layout for all its strings.",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "format": "id:lexical_item"}
    },
    "line": {
      "description": "A text line (docs/03 § Texts).",
      "type": "object",
      "required": ["speaker", "it", "en"],
      "properties": {
        "speaker": {"type": "string", "format": "id:speaker"},
        "to": {"type": "string", "format": "id:character"},
        "register": {"$ref": "#/$defs/register"},
        "it": {"$ref": "#/$defs/nonEmptyString"},
        "en": {"type": "string"},
        "foreign": {"$ref": "#/$defs/nonEmptyStrings"},
        "gloss": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/nonEmptyString"}},
        "lemmas": {"$ref": "#/$defs/lemmas"},
        "recognise": {"$ref": "#/$defs/nonEmptyStrings"},
        "allow": {
          "type": "object",
          "required": ["reason"],
          "properties": {"reason": {"$ref": "#/$defs/nonEmptyString"}},
          "additionalProperties": false
        },
        "say": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/nonEmptyString"}},
        "pause_ms": {"type": "integer", "minimum": 0}
      },
      "dependentRequired": {"to": ["register"], "register": ["to"]},
      "additionalProperties": false
    },
    "text": {
      "description": "An inline text: story, listening, real-world reading, source or audio text (docs/03 § Texts).",
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": {"type": "string", "format": "id:text"},
        "kind": {
          "enum": ["story", "dialogue", "announcement", "phone", "message", "real_world", "model"],
          "title": "text kind"
        },
        "title": {"$ref": "#/$defs/titleAny"},
        "lines": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/line"}},
        "layout": {"$ref": "#/$defs/layout"}
      },
      "additionalProperties": false,
      "if": {"properties": {"kind": {"const": "real_world"}}, "required": ["kind"]},
      "then": {"required": ["layout"]},
      "else": {"required": ["lines"]}
    },
    "textOrRef": {
      "type": ["string", "object"],
      "if": {"type": "string"},
      "then": {"format": "id:text"},
      "else": {"$ref": "#/$defs/text"}
    },
    "source": {
      "description": "What an exercise shows or reuses: a text or text line ID, {text: <id or inline text>} or {audio_text: <inline text>}.",
      "type": ["string", "object", "null"],
      "if": {"type": "string"},
      "then": {"format": "id:text|text_line"},
      "else": {
        "if": {"type": "object"},
        "then": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "x-message": "a source is either {text: …} or {audio_text: …}",
          "properties": {"text": {"$ref": "#/$defs/textOrRef"}, "audio_text": {"$ref": "#/$defs/text"}},
          "additionalProperties": false
        }
      }
    },
    "audioText": {
      "type": ["object", "null"],
      "if": {"type": "object"},
      "then": {"$ref": "#/$defs/text"}
    },
    "matcher": {
      "description": "A token matcher (docs/03 § Grammar points): every key is optional, at least one is needed.",
      "type": "object",
      "minProperties": 1,
      "properties": {
        "form": {"type": "string", "format": "regex"},
        "lemma": {"$ref": "#/$defs/nonEmptyStrings"},
        "pos": {"$ref": "#/$defs/posList"},
        "morph": {"type": "string", "format": "regex"},
        "optional": {"type": "boolean"},
        "any": {"type": "boolean", "description": "one analysis matching is enough (docs/03 § Grammar points)"}
      },
      "additionalProperties": false
    },
    "posList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Z]+(?:-[A-Z0-9]+)*$",
        "x-message": "'{value}' is not a Morph-it! category prefix such as NOUN or PRO-PERS"
      }
    },
    "layout": {
      "description": "Real-world layouts (docs/06 § 4).",
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["menu", "receipt", "sign", "hours", "timetable", "ticket", "form", "label", "ad", "message", "postcard", "list"],
          "title": "layout type"
        }
      },
      "allOf": [
        {"if": {"properties": {"type": {"const": "menu"}}, "required": ["type"]}, "then": {"$ref": "#/$defs/layoutMenu"}},
        {"if": {"properties": {"type": {"const": "receipt"}}, "required": ["type"]}, "then": {"$ref": "#/$defs/layoutReceipt"}},
        {"if": {"properties": {"type": {"const": "sign"}}, "required": ["type"]}, "then": {"$ref": "#/$defs/layoutSign"}},
        {"if": {"properties": {"type": {"const": "hours"}}, "required": ["type"]}, "then": {"$ref": "#/$defs/layoutHours"}},
        {"if": {"properties": {"type": {"const": "timetable"}}, "required": ["type"]}, "then": {"$ref": "#/$defs/layoutTimetable"}},
        {"if": {"properties": {"type": {"enum": ["ticket", "form", "label"]}}, "required": ["type"]}, "then": {"$ref": "#/$defs/layoutFields"}},
        {"if": {"properties": {"type": {"const": "ad"}}, "required": ["type"]}, "then": {"$ref": "#/$defs/layoutAd"}},
        {"if": {"properties": {"type": {"const": "message"}}, "required": ["type"]}, "then": {"$ref": "#/$defs/layoutMessage"}},
        {"if": {"properties": {"type": {"const": "postcard"}}, "required": ["type"]}, "then": {"$ref": "#/$defs/layoutPostcard"}},
        {"if": {"properties": {"type": {"const": "list"}}, "required": ["type"]}, "then": {"$ref": "#/$defs/layoutList"}}
      ]
    },
    "price": {
      "type": "string",
      "minLength": 1,
      "x-message": "write prices in layouts as strings, e.g. \"1,60\""
    },
    "layoutMenu": {
      "type": "object",
      "required": ["type", "title", "sections"],
      "properties": {
        "type": true,
        "ignore": {"$ref": "#/$defs/strings"},
        "lemmas": {"$ref": "#/$defs/lemmas"},
        "title": {"$ref": "#/$defs/nonEmptyString"},
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["title", "rows"],
            "properties": {
              "title": {"$ref": "#/$defs/nonEmptyString"},
              "rows": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["name", "price"],
                  "properties": {
                    "name": {"$ref": "#/$defs/nonEmptyString"},
                    "price": {"$ref": "#/$defs/price"},
                    "note": {"type": "string"}
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "layoutReceipt": {
      "type": "object",
      "required": ["type", "shop", "rows", "total"],
      "properties": {
        "type": true,
        "ignore": {"$ref": "#/$defs/strings"},
        "lemmas": {"$ref": "#/$defs/lemmas"},
        "shop": {"$ref": "#/$defs/nonEmptyString"},
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "price"],
            "properties": {
              "name": {"$ref": "#/$defs/nonEmptyString"},
              "qty": {"type": ["string", "integer"]},
              "price": {"$ref": "#/$defs/price"}
            },
            "additionalProperties": false
          }
        },
        "total": {"$ref": "#/$defs/price"},
        "footer": {"type": "string"}
      },
      "additionalProperties": false
    },
    "layoutSign": {
      "type": "object",
      "required": ["type", "lines"],
      "properties": {
        "type": true,
        "ignore": {"$ref": "#/$defs/strings"},
        "lemmas": {"$ref": "#/$defs/lemmas"},
        "lines": {"$ref": "#/$defs/nonEmptyStrings"},
        "style": {"enum": ["info", "warning", "closed"], "title": "sign style"}
      },
      "additionalProperties": false
    },
    "layoutHours": {
      "type": "object",
      "required": ["type", "title", "rows"],
      "properties": {
        "type": true,
        "ignore": {"$ref": "#/$defs/strings"},
        "lemmas": {"$ref": "#/$defs/lemmas"},
        "title": {"$ref": "#/$defs/nonEmptyString"},
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["days", "times"],
            "properties": {"days": {"$ref": "#/$defs/nonEmptyString"}, "times": {"$ref": "#/$defs/nonEmptyString"}},
            "additionalProperties": false
          }
        },
        "note": {"type": "string"}
      },
      "additionalProperties": false
    },
    "layoutTimetable": {
      "type": "object",
      "required": ["type", "title", "columns", "rows"],
      "properties": {
        "type": true,
        "ignore": {"$ref": "#/$defs/strings"},
        "lemmas": {"$ref": "#/$defs/lemmas"},
        "title": {"$ref": "#/$defs/nonEmptyString"},
        "columns": {"$ref": "#/$defs/nonEmptyStrings"},
        "rows": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/strings"}}
      },
      "additionalProperties": false
    },
    "layoutFields": {
      "type": "object",
      "required": ["type", "title", "fields"],
      "properties": {
        "type": true,
        "ignore": {"$ref": "#/$defs/strings"},
        "lemmas": {"$ref": "#/$defs/lemmas"},
        "title": {"$ref": "#/$defs/nonEmptyString"},
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["label", "value"],
            "properties": {"label": {"$ref": "#/$defs/nonEmptyString"}, "value": {"type": "string"}},
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "layoutAd": {
      "type": "object",
      "required": ["type", "title", "body"],
      "properties": {
        "type": true,
        "ignore": {"$ref": "#/$defs/strings"},
        "lemmas": {"$ref": "#/$defs/lemmas"},
        "title": {"$ref": "#/$defs/nonEmptyString"},
        "body": {"$ref": "#/$defs/nonEmptyStrings"},
        "contact": {"type": "string"}
      },
      "additionalProperties": false
    },
    "layoutMessage": {
      "type": "object",
      "required": ["type", "from", "bubbles"],
      "properties": {
        "type": true,
        "ignore": {"$ref": "#/$defs/strings"},
        "lemmas": {"$ref": "#/$defs/lemmas"},
        "from": {"$ref": "#/$defs/nonEmptyString"},
        "time": {"type": "string"},
        "bubbles": {"$ref": "#/$defs/nonEmptyStrings"}
      },
      "additionalProperties": false
    },
    "layoutPostcard": {
      "type": "object",
      "required": ["type", "greeting", "body", "closing", "signature"],
      "properties": {
        "type": true,
        "ignore": {"$ref": "#/$defs/strings"},
        "lemmas": {"$ref": "#/$defs/lemmas"},
        "greeting": {"$ref": "#/$defs/nonEmptyString"},
        "body": {"$ref": "#/$defs/nonEmptyStrings"},
        "closing": {"$ref": "#/$defs/nonEmptyString"},
        "signature": {"$ref": "#/$defs/nonEmptyString"},
        "address": {"$ref": "#/$defs/strings"}
      },
      "additionalProperties": false
    },
    "layoutList": {
      "type": "object",
      "required": ["type", "items"],
      "properties": {
        "type": true,
        "ignore": {"$ref": "#/$defs/strings"},
        "lemmas": {"$ref": "#/$defs/lemmas"},
        "title": {"type": "string"},
        "items": {"$ref": "#/$defs/nonEmptyStrings"}
      },
      "additionalProperties": false
    }
  }
}
