{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://italiano.invalid/schemas/exercise.schema.json",
  "title": "Exercise",
  "description": "Any authored exercise: dispatches on `format` to the format's own schema in exercises/ (docs/06). Containers narrow the allowed formats.",
  "type": "object",
  "required": ["id", "format"],
  "properties": {
    "id": {"type": "string", "format": "id:exercise"},
    "format": {
      "enum": ["cloze", "recall", "sentence-building", "dictation", "sound-pair", "repeat", "choice", "true-false", "match", "conversation", "talk", "writing", "relay"],
      "title": "exercise format"
    }
  },
  "allOf": [
    {"if": {"properties": {"format": {"const": "cloze"}}, "required": ["format"]}, "then": {"$ref": "exercises/cloze.schema.json"}},
    {"if": {"properties": {"format": {"const": "recall"}}, "required": ["format"]}, "then": {"$ref": "exercises/recall.schema.json"}},
    {"if": {"properties": {"format": {"const": "sentence-building"}}, "required": ["format"]}, "then": {"$ref": "exercises/sentence-building.schema.json"}},
    {"if": {"properties": {"format": {"const": "dictation"}}, "required": ["format"]}, "then": {"$ref": "exercises/dictation.schema.json"}},
    {"if": {"properties": {"format": {"const": "sound-pair"}}, "required": ["format"]}, "then": {"$ref": "exercises/sound-pair.schema.json"}},
    {"if": {"properties": {"format": {"const": "repeat"}}, "required": ["format"]}, "then": {"$ref": "exercises/repeat.schema.json"}},
    {"if": {"properties": {"format": {"const": "choice"}}, "required": ["format"]}, "then": {"$ref": "exercises/choice.schema.json"}},
    {"if": {"properties": {"format": {"const": "true-false"}}, "required": ["format"]}, "then": {"$ref": "exercises/true-false.schema.json"}},
    {"if": {"properties": {"format": {"const": "match"}}, "required": ["format"]}, "then": {"$ref": "exercises/match.schema.json"}},
    {"if": {"properties": {"format": {"const": "conversation"}}, "required": ["format"]}, "then": {"$ref": "exercises/conversation.schema.json"}},
    {"if": {"properties": {"format": {"const": "talk"}}, "required": ["format"]}, "then": {"$ref": "exercises/talk.schema.json"}},
    {"if": {"properties": {"format": {"const": "writing"}}, "required": ["format"]}, "then": {"$ref": "exercises/writing.schema.json"}},
    {"if": {"properties": {"format": {"const": "relay"}}, "required": ["format"]}, "then": {"$ref": "exercises/relay.schema.json"}}
  ]
}
