{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://italiano.invalid/schemas/items.schema.json",
  "title": "Items of one unit (content/items/uNN.yaml)",
  "description": "docs/03 § Items: words (w:), chunks (c:, kind: chunk) and sounds (s:, kind: sound) introduced in the unit.",
  "type": "object",
  "required": ["unit", "review", "items"],
  "properties": {
    "unit": {"type": "string", "format": "id:unit"},
    "review": {"$ref": "common.schema.json#/$defs/review"},
    "items": {"type": "array", "items": {"$ref": "#/$defs/item"}}
  },
  "additionalProperties": false,
  "$defs": {
    "item": {
      "type": "object",
      "required": ["id", "it", "gloss", "status", "lesson"],
      "properties": {
        "id": {"type": "string", "format": "id:lexical_item"},
        "kind": {"enum": ["chunk", "sound"], "title": "item kind"},
        "it": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
        "pos": {
          "enum": ["noun", "verb", "adj", "adv", "prep", "conj", "pron", "det", "num", "interj"],
          "title": "part of speech"
        },
        "gender": {"enum": ["m", "f", "mf"], "title": "gender"},
        "plural": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
        "gloss": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
        "alt_glosses": {"$ref": "common.schema.json#/$defs/nonEmptyStrings"},
        "note": {"type": "string"},
        "topics": {"type": "array", "items": {"type": "string", "format": "id:topic"}},
        "status": {
          "type": ["string", "object"],
          "if": {"type": "string"},
          "then": {"$ref": "common.schema.json#/$defs/itemStatus"},
          "else": {
            "type": "object",
            "minProperties": 1,
            "properties": {
              "read": {"$ref": "common.schema.json#/$defs/itemStatus"},
              "listen": {"$ref": "common.schema.json#/$defs/itemStatus"},
              "recall": {"$ref": "common.schema.json#/$defs/itemStatus"},
              "speak": {"$ref": "common.schema.json#/$defs/itemStatus"}
            },
            "additionalProperties": false
          }
        },
        "lesson": {"type": "string", "format": "id:lesson"},
        "match": {"$ref": "common.schema.json#/$defs/nonEmptyStrings"},
        "exemplifies": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "id:grammar"}},
        "pairs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "minLength": 1}}
        },
        "articles": {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "indef": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
            "def": {"$ref": "common.schema.json#/$defs/nonEmptyString"}
          },
          "additionalProperties": false
        },
        "forms": {"$ref": "common.schema.json#/$defs/nonEmptyStrings"},
        "recall_answer": {"$ref": "common.schema.json#/$defs/pattern"},
        "case_sensitive": {"type": "boolean"},
        "cognate": {"type": "boolean"},
        "false_friend": {"type": "boolean"},
        "audio_say": {"$ref": "common.schema.json#/$defs/nonEmptyString"}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "chunk"}}, "required": ["kind"]},
          "then": {"required": ["match"], "x-message": "a chunk needs match: the surface sequences the annotator recognises"}
        },
        {
          "if": {"not": {"required": ["kind"]}},
          "then": {"required": ["pos"], "x-message": "a word needs pos (or kind: chunk / kind: sound)"}
        },
        {
          "if": {"properties": {"pos": {"const": "noun"}}, "required": ["pos"]},
          "then": {"required": ["gender", "plural"], "x-message": "a noun needs gender and plural (plural: invariable if it doesn't change)"}
        }
      ]
    }
  }
}
