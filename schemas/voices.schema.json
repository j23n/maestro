{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://italiano.invalid/schemas/voices.schema.json",
  "title": "TTS voices (content/voices.yaml)",
  "description": "docs/04 § Audio, ADR-07: standard (non-HD) it-IT neural voices only, per speaker; ch:you has one voice per learner gender, ch:extra a pool.",
  "type": "object",
  "required": ["voices"],
  "properties": {
    "default_rate": {"$ref": "#/$defs/rate"},
    "slow_rate": {"$ref": "#/$defs/rate"},
    "voices": {
      "type": "object",
      "x-keys": "narrator, announcer, items, ch:<character>, ch:you (m and f voices), ch:extra (a pool)",
      "properties": {
        "ch:you": {"$ref": "#/$defs/gendered"},
        "ch:extra": {"$ref": "#/$defs/pool"}
      },
      "patternProperties": {
        "^(?!ch:(?:you|extra)$)(?:narrator|announcer|items|ch:[a-z0-9]+(?:-[a-z0-9]+)*)$": {"$ref": "#/$defs/voice"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "rate": {
      "type": "string",
      "pattern": "^[+-]?\\d+(?:\\.\\d+)?%$",
      "x-message": "'{value}' is not a relative rate like \"-10%\""
    },
    "voiceName": {
      "type": "string",
      "pattern": "^[a-z]{2}-[A-Z]{2}-[A-Za-z]+Neural$",
      "x-message": "'{value}' is not a standard neural voice name like it-IT-ElsaNeural (HD voices can't be used, ADR-07)"
    },
    "voice": {
      "type": "object",
      "required": ["voice"],
      "properties": {
        "voice": {"$ref": "#/$defs/voiceName"},
        "rate": {"$ref": "#/$defs/rate"},
        "pitch": {"$ref": "#/$defs/rate"},
        "effect": {"enum": ["station"], "title": "audio effect"}
      },
      "additionalProperties": false
    },
    "gendered": {
      "type": "object",
      "required": ["m", "f"],
      "properties": {"m": {"$ref": "#/$defs/voice"}, "f": {"$ref": "#/$defs/voice"}},
      "additionalProperties": false
    },
    "pool": {
      "type": "object",
      "required": ["voices", "pick"],
      "properties": {
        "voices": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/voiceName"}},
        "pick": {"$ref": "common.schema.json#/$defs/nonEmptyString"}
      },
      "additionalProperties": false
    }
  }
}
