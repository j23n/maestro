{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://italiano.invalid/schemas/checker.schema.json",
  "title": "Checker thresholds (content/checker.yaml)",
  "description": "docs/04 § The ten quality checks. Changing a threshold is a decision (note it in PROGRESS.md).",
  "type": "object",
  "required": ["coverage_mode", "level_gate", "recycling", "strands", "durations_seconds"],
  "properties": {
    "coverage_mode": {"enum": ["report", "enforce"], "title": "coverage mode"},
    "level_gate": {
      "type": "object",
      "required": ["story_new_token_max", "real_world_new_token_max"],
      "properties": {
        "story_new_token_max": {"$ref": "#/$defs/share"},
        "real_world_new_token_max": {"$ref": "#/$defs/share"},
        "allow_requires_reason": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "recycling": {
      "type": "object",
      "additionalProperties": {"type": "number", "minimum": 0}
    },
    "strands": {
      "type": "object",
      "required": ["bands", "by_kind"],
      "properties": {
        "bands": {
          "type": "object",
          "description": "Each strand's share of a complete unit's estimated minutes (check 3 · strand balance, CL21).",
          "required": ["input", "output", "language-focus", "fluency"],
          "propertyNames": {"enum": ["input", "output", "language-focus", "fluency"], "title": "strand"},
          "additionalProperties": {
            "type": "object",
            "required": ["min", "max"],
            "properties": {"min": {"$ref": "#/$defs/bound"}, "max": {"$ref": "#/$defs/bound"}},
            "additionalProperties": false
          }
        },
        "by_kind": {
          "type": "object",
          "propertyNames": {
            "enum": ["preview", "story", "listening", "reading", "note", "practice", "sounds", "use", "opener", "conversation", "talk", "writing", "relay", "check", "fluency", "comprehension", "cloze", "recall", "sentence-building", "dictation", "sound-pair", "repeat", "choice", "true-false", "match"],
            "title": "step kind or exercise format"
          },
          "additionalProperties": {"enum": ["input", "output", "language-focus", "fluency"], "title": "strand"}
        }
      },
      "additionalProperties": false
    },
    "durations_seconds": {
      "type": "object",
      "required": ["audio_per_word"],
      "properties": {
        "audio_per_word": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Check 3 only: seconds of audio per word of a story or listening text (CL21)."
        }
      },
      "additionalProperties": {"type": "number", "exclusiveMinimum": 0}
    },
    "warnings_fail_in_release": {"type": "boolean"}
  },
  "additionalProperties": false,
  "$defs": {
    "share": {"type": "number", "minimum": 0, "maximum": 1},
    "bound": {
      "description": "A share, or {unit: share} where each share holds from its unit on (course order; the first key is the course's first unit).",
      "oneOf": [
        {"$ref": "#/$defs/share"},
        {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"pattern": "^u[0-9]{2}$", "title": "unit"},
          "additionalProperties": {"$ref": "#/$defs/share"}
        }
      ]
    }
  }
}
