{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://italiano.invalid/schemas/disambiguation.schema.json",
  "title": "Disambiguation of ambiguous forms (content/disambiguation.yaml)",
  "description": "docs/04 § Annotation step 4. A rule names `form` or `forms`, a `choose` (item ID or {pos: [...]}) under `when_any` conditions, and an `otherwise`; `defaults` give a form's reading when no rule decides.",
  "type": "object",
  "properties": {
    "context_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["choose", "when_any"],
        "properties": {
          "form": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
          "forms": {"$ref": "common.schema.json#/$defs/nonEmptyStrings"},
          "choose": {"$ref": "#/$defs/choice"},
          "when_any": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "minProperties": 1,
              "properties": {
                "prev": {"$ref": "common.schema.json#/$defs/matcher"},
                "next": {"$ref": "common.schema.json#/$defs/matcher"}
              },
              "additionalProperties": false
            }
          },
          "otherwise": {"$ref": "#/$defs/choice"}
        },
        "additionalProperties": false,
        "if": {"required": ["form"]},
        "then": {"not": {"required": ["forms"]}, "x-message": "a rule has form or forms, not both"},
        "else": {"required": ["forms"], "x-message": "a rule needs form (one form) or forms (a list)"}
      }
    },
    "defaults": {
      "description": "The reading of a form when no `lemmas:` override or context rule decides: an item ID (chosen among several candidates), or {pos: [...]} to keep only those Morph-it! readings, even with one candidate (a letter name that is also a clitic: ci).",
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/choice"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "choice": {
      "type": ["string", "object"],
      "if": {"type": "string"},
      "then": {"format": "id:lexical_item"},
      "else": {
        "required": ["pos"],
        "properties": {"pos": {"$ref": "common.schema.json#/$defs/posList"}},
        "additionalProperties": false
      }
    }
  }
}
