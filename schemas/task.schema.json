{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://italiano.invalid/schemas/task.schema.json",
  "title": "Unit task (content/units/NN-slug/task.yaml)",
  "description": "docs/06 § 12–15 and § Unit-level steps: conversations, then talk, writing and relay (null where the unit has none).",
  "type": "object",
  "required": ["id", "review"],
  "properties": {
    "id": {"type": "string", "format": "id:task_file"},
    "review": {"$ref": "common.schema.json#/$defs/review"},
    "conversations": {
      "type": "array",
      "items": {"$ref": "exercise.schema.json", "properties": {"format": {"enum": ["conversation"]}}}
    },
    "talk": {
      "type": ["object", "null"],
      "if": {"type": "object"},
      "then": {"$ref": "exercise.schema.json", "properties": {"format": {"enum": ["talk"]}}}
    },
    "writing": {
      "type": ["object", "null"],
      "if": {"type": "object"},
      "then": {"$ref": "exercise.schema.json", "properties": {"format": {"enum": ["writing"]}}}
    },
    "relay": {
      "type": ["object", "null"],
      "if": {"type": "object"},
      "then": {"$ref": "exercise.schema.json", "properties": {"format": {"enum": ["relay"]}}}
    }
  },
  "additionalProperties": false
}
