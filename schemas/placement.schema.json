{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://italiano.invalid/schemas/placement.schema.json",
  "title": "Placement (content/assessments/placement.yaml)",
  "description": "docs/05 § Placement, docs/06 § 19. Blocks for Units 1–8; exercise IDs are pl.NN.",
  "type": "object",
  "required": ["id", "review", "advance_threshold", "blocks"],
  "properties": {
    "id": {"const": "placement"},
    "review": {"$ref": "common.schema.json#/$defs/review"},
    "advance_threshold": {"type": "integer", "minimum": 1},
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["unit", "exercises"],
        "properties": {
          "unit": {"type": "string", "format": "id:unit"},
          "exercises": {
            "type": "array",
            "items": {
              "$ref": "exercise.schema.json",
              "properties": {
                "format": {"enum": ["cloze", "recall", "sentence-building", "dictation", "choice", "true-false", "match"]}
              }
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
