{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://italiano.invalid/schemas/course.schema.json",
  "title": "Course metadata and unit order (content/course.yaml)",
  "description": "docs/03 § course.yaml. `units` lists the unit folders under content/units/ in course order.",
  "type": "object",
  "required": ["course", "version", "locale", "title", "units"],
  "properties": {
    "course": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "x-message": "'{value}' is not a lowercase slug"},
    "version": {"$ref": "common.schema.json#/$defs/semver"},
    "locale": {"type": "string", "pattern": "^[a-z]{2}-[A-Z]{2}$", "x-message": "'{value}' is not a locale like it-IT"},
    "title": {"$ref": "common.schema.json#/$defs/titleEn"},
    "units": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^\\d{2}-[a-z0-9]+(?:-[a-z0-9]+)*$",
        "x-message": "'{value}' is not a unit folder name like 02-al-bar"
      }
    }
  },
  "additionalProperties": false
}
