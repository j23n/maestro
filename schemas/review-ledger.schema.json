{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://italiano.invalid/schemas/review-ledger.schema.json",
  "title": "Review ledger (reviews/<scope>.yaml)",
  "description": "docs/04 § Content review loop › Back into the project. Every comment of every imported review file, as filed, plus where it came from (`review`), whether it was made on an older version (`stale`) and what was done about it (`resolution`). Comments are never deleted or merged.",
  "type": "object",
  "required": ["scope", "comments"],
  "properties": {
    "scope": {"$ref": "review-file.schema.json#/$defs/scope"},
    "comments": {"type": "array", "items": {"$ref": "#/$defs/entry"}}
  },
  "additionalProperties": false,
  "$defs": {
    "entry": {
      "type": "object",
      "required": ["id", "target", "file", "verdict", "at", "review", "stale", "resolution"],
      "$ref": "review-file.schema.json#/$defs/commentFields",
      "properties": {
        "id": true,
        "target": true,
        "file": true,
        "quote": true,
        "verdict": true,
        "category": true,
        "comment": true,
        "suggestion": true,
        "response": true,
        "at": true,
        "review": {
          "type": "string",
          "pattern": "^reviews/inbox/[^/\\s]+\\.json$",
          "x-message": "'{value}' is not a review file in reviews/inbox/"
        },
        "reviewer": {"type": "string"},
        "hash": {
          "description": "The approval hash of the file version the comment was made on (from the review file's `files`).",
          "anyOf": [{"type": "null"}, {"$ref": "review-file.schema.json#/$defs/hash"}]
        },
        "stale": {"type": "boolean"},
        "resolution": {"$ref": "#/$defs/resolution"}
      },
      "additionalProperties": false
    },
    "resolution": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["open", "fixed", "answered", "declined", "owner"], "title": "resolution status"},
        "note": {"type": ["string", "null"]},
        "commit": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{7,40}$",
          "x-message": "'{value}' is not a commit SHA"
        }
      },
      "additionalProperties": false,
      "if": {"properties": {"status": {"enum": ["answered", "declined", "owner"]}}, "required": ["status"]},
      "then": {
        "required": ["note"],
        "properties": {
          "note": {
            "type": "string",
            "minLength": 1,
            "x-message": "an answered, declined or owner resolution needs a note for the teacher"
          }
        },
        "x-message": "an answered, declined or owner resolution needs a note for the teacher"
      }
    }
  }
}
