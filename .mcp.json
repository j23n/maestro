{
  "mcpServers": {
    "MobileBuildMCP": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "mobilebuildmcp@2.7.1",
        "mcp"
      ],
      "env": {
        "MOBILEBUILDMCP_ENABLED_WORKFLOWS": "simulator,ui-automation,macos,swift-package,session-management,project-discovery",
        "MOBILEBUILDMCP_SENTRY_DISABLED": "true"
      }
    }
  }
}
