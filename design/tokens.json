{
  "$description": "Libro design tokens. Light values are taken from the design canvas (design/source), except the four contrast fixes listed in $contrastChanges. Dark values are a proposal. Sizes are points. Contrast rules: docs/07 § Layout rules.",
  "$contrastChanges": {
    "light.inputBorder": {
      "canvas": "#D9CEC5",
      "now": "#A38973",
      "why": "1.55:1 → 3.29:1 on background, 3.01:1 on surface"
    },
    "light.switchOff": {
      "canvas": "#DDD2C9",
      "now": "#A58871",
      "why": "1.49:1 → 3.30:1 on background"
    },
    "dark.inputBorder": {
      "canvas": "#4A403A",
      "now": "#78685E",
      "why": "1.76:1 → 3.33:1 on background"
    },
    "dark.switchOff": {
      "canvas": "#4A403A",
      "now": "#78685E",
      "why": "1.76:1 → 3.33:1 on background"
    },
    "dark.accentTint": {
      "canvas": "#4A2A1E",
      "now": "#45271C",
      "why": "accent text on accentTint 4.31:1 → 4.53:1"
    }
  },
  "color": {
    "light": {
      "background": "#FFFFFF",
      "surface": "#F9F4EF",
      "subtle": "#F4EEE8",
      "divider": "#EDE5DE",
      "inputBorder": "#A38973",
      "switchOff": "#A58871",
      "ink": "#2B211C",
      "secondary": "#6B5E55",
      "accent": "#A84A24",
      "accentPressed": "#7F3517",
      "accentTint": "#F6E3D8",
      "onAccent": "#FFFFFF",
      "success": "#2F6B3A",
      "warning": "#B26B00",
      "warningBackground": "#FDF4E3",
      "warningText": "#7A4A00",
      "warningInputBackground": "#FFFBF3"
    },
    "dark": {
      "background": "#1C1714",
      "surface": "#26201C",
      "subtle": "#2E2723",
      "divider": "#3A322C",
      "inputBorder": "#78685E",
      "switchOff": "#78685E",
      "ink": "#F3ECE6",
      "secondary": "#B9ABA0",
      "accent": "#E07A50",
      "accentPressed": "#F09068",
      "accentTint": "#45271C",
      "onAccent": "#1C1714",
      "success": "#6FBF7A",
      "warning": "#F2B24B",
      "warningBackground": "#3A2C14",
      "warningText": "#F2C46B",
      "warningInputBackground": "#2B2318"
    }
  },
  "font": {
    "italian": "Literata",
    "ui": "Instrument Sans",
    "files": [
      "design/fonts/Literata[opsz,wght].ttf",
      "design/fonts/Literata-Italic[opsz,wght].ttf",
      "design/fonts/InstrumentSans[wdth,wght].ttf",
      "design/fonts/InstrumentSans-Italic[wdth,wght].ttf"
    ]
  },
  "type": {
    "$note": "Every style scales with Dynamic Type relative to the listed text style (Font.custom(_:size:relativeTo:)).",
    "display": {
      "font": "italian",
      "size": 52,
      "weight": 600,
      "lineHeight": 1.05,
      "relativeTo": "largeTitle",
      "use": "Course title on iPad/Mac (Indice)"
    },
    "celebration": {
      "font": "italian",
      "size": 44,
      "weight": 600,
      "relativeTo": "largeTitle",
      "use": "Bravo!"
    },
    "screenTitle": {
      "font": "italian",
      "size": 34,
      "weight": 600,
      "lineHeight": 1.2,
      "relativeTo": "largeTitle",
      "use": "Buongiorno, Settings, Welcome"
    },
    "unitTitle": {
      "font": "italian",
      "size": 40,
      "weight": 600,
      "relativeTo": "largeTitle",
      "use": "Unit overview title"
    },
    "noteTitle": {
      "font": "italian",
      "size": 36,
      "weight": 600,
      "relativeTo": "title",
      "use": "Grammar note title, word panel headword"
    },
    "sectionTitle": {
      "font": "italian",
      "size": 28,
      "weight": 600,
      "relativeTo": "title2",
      "use": "Stats numbers, section titles"
    },
    "rowTitle": {
      "font": "italian",
      "size": 24,
      "weight": 600,
      "relativeTo": "title3",
      "use": "Course list rows"
    },
    "itemTitle": {
      "font": "italian",
      "size": 22,
      "weight": 600,
      "relativeTo": "title3",
      "use": "Continue card title, dialogue lines (compact)"
    },
    "storyRegular": {
      "font": "italian",
      "size": 28,
      "weight": 400,
      "lineHeight": 1.6,
      "relativeTo": "title2",
      "use": "Story text, regular width"
    },
    "storyCompact": {
      "font": "italian",
      "size": 22,
      "weight": 400,
      "lineHeight": 1.55,
      "relativeTo": "title3",
      "use": "Story text, compact width"
    },
    "exercise": {
      "font": "italian",
      "size": 34,
      "weight": 400,
      "lineHeight": 1.35,
      "relativeTo": "title",
      "use": "Cloze sentence, recall prompt"
    },
    "answerInput": {
      "font": "italian",
      "size": 20,
      "weight": 400,
      "relativeTo": "body",
      "use": "Answer field"
    },
    "italianBody": {
      "font": "italian",
      "size": 19,
      "weight": 400,
      "lineHeight": 1.6,
      "relativeTo": "body",
      "use": "Italian inside notes, model answers"
    },
    "translation": {
      "font": "italian",
      "size": 18,
      "weight": 400,
      "italic": true,
      "relativeTo": "body",
      "use": "English support line under Italian"
    },
    "uiTitle": {
      "font": "ui",
      "size": 18,
      "weight": 600,
      "relativeTo": "headline",
      "use": "Card headers (Review, Continue)"
    },
    "uiBody": {
      "font": "ui",
      "size": 17,
      "weight": 400,
      "lineHeight": 1.45,
      "relativeTo": "body"
    },
    "uiButton": {
      "font": "ui",
      "size": 17,
      "weight": 600,
      "relativeTo": "body"
    },
    "uiCallout": {
      "font": "ui",
      "size": 15,
      "weight": 400,
      "relativeTo": "callout"
    },
    "uiCaption": {
      "font": "ui",
      "size": 14,
      "weight": 400,
      "relativeTo": "footnote"
    },
    "uiMicro": {
      "font": "ui",
      "size": 12,
      "weight": 500,
      "relativeTo": "caption",
      "use": "Tab labels, speaker small caps"
    }
  },
  "space": {
    "xxs": 2,
    "xs": 4,
    "s": 8,
    "m": 12,
    "l": 16,
    "xl": 20,
    "xxl": 24,
    "xxxl": 28,
    "section": 22,
    "screenPaddingCompact": 24,
    "screenPaddingRegular": 40
  },
  "radius": {
    "key": 10,
    "input": 12,
    "tile": 14,
    "tableCard": 16,
    "card": 18,
    "optionCard": 18,
    "pill": 999
  },
  "size": {
    "minTouch": 44,
    "primaryButtonHeight": 56,
    "homeButtonHeight": 50,
    "secondaryButtonHeight": 46,
    "inputHeight": 56,
    "accentKeyHeight": 44,
    "progressBarHeight": 4,
    "bigPlayButton": 88,
    "optionCardHeight": 120,
    "toggle": {
      "width": 52,
      "height": 32,
      "knob": 26
    },
    "tabBarHeight": 84,
    "readableWidth": 720,
    "storyMeasureEm": 32,
    "macMinWindow": {
      "width": 900,
      "height": 620
    }
  },
  "border": {
    "hairline": 1,
    "control": 1.5,
    "inputError": 2
  },
  "motion": {
    "feedbackPanelMs": 200,
    "highlightFadeMs": 120,
    "reduceMotion": "no mascot animation; cross-fades only"
  },
  "mascot": {
    "name": "Moka",
    "poses": {
      "hello": "welcome, start of each day",
      "think": "hints, grammar notes, second tries",
      "cheer": "a finished session or a new can-do",
      "sleep": "rest days, quiet hours"
    },
    "sizes": [
      40,
      56,
      72,
      96,
      150,
      180
    ],
    "assets": "design/mascot/moka-<pose>.svg (alternates: tito-<pose>.svg, tazzina.svg, cappuccio.svg)"
  }
}
