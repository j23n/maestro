{
  "$description": "Colour, type and shape tokens taken from the mocks (light mode only; dark mode not designed yet).",
  "color": {
    "ink": "#17181A",
    "textSecondary": "#4A4E55",
    "textTertiary": "#5B5F66",
    "textPronoun": "#6A6E75",
    "background": "#FFFFFF",
    "backgroundGrouped": "#F2F2F4",
    "surface": "#F4F4F5",
    "surfaceChip": "#F1F2F4",
    "surfaceSidebar": "#F6F6F7",
    "surfaceInspector": "#FBFBFC",
    "hairline": "#E4E5E8",
    "divider": "#ECEDEF",
    "borderControl": "#8E9299",
    "borderInput": "#C3C6CC",
    "accent": "#2251CC",
    "accentPressed": "#173A94",
    "selectionFill": "#DCE5FF",
    "selectionRing": "#2251CC",
    "infoBackground": "#EEF2FF",
    "infoTitle": "#1E3F99",
    "added": {"background": "#E7F3EC", "foreground": "#1D5A35", "border": "#8CC3A0"},
    "toggleOn": "#2F8F57",
    "error": {"background": "#FDECEA", "foreground": "#8E1B1B", "border": "#B42318"},
    "warning": {"background": "#FFF4E5", "foreground": "#6B3A00", "icon": "#8A4B00"},
    "irregularForm": "#9A4300",
    "irregularBadge": {"background": "#FFF0E3", "foreground": "#8A3D00"},
    "moodTrigger": {"background": "#FBE3EF", "foreground": "#6E0F43", "underline": "#B0186A"},
    "kind": {
      "word": {"background": "#F1F2F4", "foreground": "#2B2E33"},
      "verbForm": {"background": "#DDF1EB", "foreground": "#1F5F52"},
      "grammar": {"background": "#E3EAFF", "foreground": "#1E3F99"}
    },
    "level": {
      "A1": {"background": "#E4F2D8", "foreground": "#2F5A12"},
      "A2": {"background": "#CDEBE3", "foreground": "#1F5F52"},
      "B1": {"background": "#DCE5FF", "foreground": "#1E3F99"},
      "B2": {"background": "#E2D6FF", "foreground": "#4B2A9B"}
    },
    "grade": {
      "again": {"background": "#FBE7E7", "foreground": "#8E1B1B"},
      "hard": {"background": "#F6EEDC", "foreground": "#6B4E00"},
      "good": {"background": "#E7F3EC", "foreground": "#1D5A35"},
      "easy": {"background": "#E3EAFF", "foreground": "#1E3F99"}
    },
    "tenseSwatch": {
      "$note": "Only in verb tables, never in the reader.",
      "presente": "#ECEEF1",
      "imperfetto": "#CDEBE3",
      "futuro": "#E4F2D8"
    }
  },
  "font": {
    "reading": "New York (mocks: Source Serif 4)",
    "ui": "SF Pro (mocks: Inter)"
  },
  "type": {
    "readingText": {"iPhone": 19, "iPad": 22, "Mac": 21, "lineHeight": 1.7},
    "largeTitle": {"size": 32, "weight": "bold"},
    "sectionLabel": {"size": 12, "weight": "semibold", "uppercase": true, "tracking": "0.06em"},
    "body": 15,
    "meta": 13,
    "tag": {"size": 11, "weight": "semibold"}
  },
  "radius": {
    "tag": 5,
    "badge": 6,
    "button": 12,
    "card": 14,
    "cardLarge": 16,
    "chip": 16,
    "sheet": 20
  },
  "touchTarget": {"iOS": 44, "macRow": 36}
}
