<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged with the generated Info.plist (GENERATE_INFOPLIST_FILE = YES). Values come from App/Config/*.xcconfig.
     Kept outside the synchronized App/Italiano folder so it is never copied as a resource. -->
<plist version="1.0">
<dict>
	<key>ITA_STUDY_BUILD</key>
	<string>$(ITA_STUDY_BUILD)</string>
	<key>ITA_TELEMETRY_URL</key>
	<string>$(ITA_TELEMETRY_URL)</string>
	<key>ITA_DEBUG_MENU</key>
	<string>$(ITA_DEBUG_MENU)</string>
	<key>ITA_LLM_HINTS</key>
	<string>$(ITA_LLM_HINTS)</string>
	<key>ITA_SYNC_ENABLED</key>
	<string>$(ITA_SYNC_ENABLED)</string>
	<key>ITA_ICLOUD_ENTITLEMENT</key>
	<string>$(ITA_ICLOUD_ENTITLEMENT)</string>
	<key>ITA_REVIEW_MODE</key>
	<string>$(ITA_REVIEW_MODE)</string>
	<key>ITA_REVIEW_URL</key>
	<string>$(ITA_REVIEW_URL)</string>
	<key>ITA_STUDY_TOKEN</key>
	<string>$(ITA_STUDY_TOKEN)</string>
	<key>ITA_REVIEW_TOKEN</key>
	<string>$(ITA_REVIEW_TOKEN)</string>
	<key>ITA_PACK</key>
	<string>$(ITA_PACK)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- The launch screen (iOS and iPadOS; macOS has none): the `background` colour of the loading screen that
	     RootView draws next, light or dark (task M6.2). LaunchBackground.colorset is generated from
	     design/tokens.json by scripts/gen-tokens.py. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
</dict>
</plist>
