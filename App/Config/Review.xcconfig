// Review (TestFlight, the content lead only): dev pack with drafts, review mode, no sync or telemetry
// (docs/02 § App configuration, docs/04 § Review mode in the app).
#include "Release.xcconfig"

ITA_PACK = dev
ITA_REVIEW_MODE = YES
ITA_SYNC_ENABLED = NO
// The owner sets the review endpoint and token in the gitignored Secrets-Review.xcconfig:
//   ITA_REVIEW_URL = https:/$()/<review host>
//   ITA_REVIEW_TOKEN = …
#include? "Secrets-Review.xcconfig"
// No telemetry from the content lead's builds, whatever the secrets file holds (docs/12).
ITA_TELEMETRY_URL =
ITA_STUDY_TOKEN =
