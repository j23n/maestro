// Release: the release pack, no debug tools (docs/02 § App configuration).
#include "Base.xcconfig"

ITA_PACK = release
// ITA_SYNC_ENABLED = YES after the owner deploys the CloudKit schema (M7.5).

SWIFT_OPTIMIZATION_LEVEL = -O
SWIFT_COMPILATION_MODE = wholemodule
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym
VALIDATE_PRODUCT = YES
