<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The owner's signed builds only (docs/02 § Project, signing and entitlements; ADR-18, ADR-19). The owner's
     gitignored Signing.xcconfig points CODE_SIGN_ENTITLEMENTS here. Agents never sign with these: the first signed
     CloudKit build creates iCloud.com.j23n.italian for good. The macOS sandbox capabilities are build settings
     (Base.xcconfig). To check at the first signed build (M6.8): macOS names the push key
     com.apple.developer.aps-environment; if Xcode's capability editor doesn't handle that for the macOS slice,
     add it here (or use an sdk-conditional CODE_SIGN_ENTITLEMENTS in Signing.xcconfig). -->
<plist version="1.0">
<dict>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.j23n.italian</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
